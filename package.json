{
  "name": "american-barber-tattoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "migration:new": "supabase migration new",
    "types:generate": "supabase gen types typescript --local > src/types/database.ts",
    "db:push:remote": "node scripts/supabase-remote.mjs db push",
    "db:migrate:remote": "node scripts/supabase-remote.mjs migration up",
    "db:diff:remote": "node scripts/supabase-remote.mjs db diff -f",
    "types:generate:remote": "node scripts/supabase-remote.mjs gen types typescript --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.78.0",
    "luxon": "^3.7.2",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  }
}
