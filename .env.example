# Supabase (see DESIGN.md section M / README for setup)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret — server-side only, bypasses RLS. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection (Session Pooler — the direct db.<ref> host is IPv6-only
# and may be unreachable on IPv4-only networks), used by
# scripts/supabase-remote.mjs to push migrations / generate types without
# `supabase link`. Percent-encode special characters in the password.
# Get this from Project Settings > Database > Connection string > Session pooler.
SUPABASE_DB_URL=

# Supabase CLI — local dev only, read by `supabase start` via env() substitution
# in supabase/config.toml. Put real values in supabase/.env (gitignored), not here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MVP tenant resolution (Phase 6) - which organization a new signup joins.
DEFAULT_ORG_SLUG=american-barber-tattoo
